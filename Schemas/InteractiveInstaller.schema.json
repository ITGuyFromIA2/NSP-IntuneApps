{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nsp.example/IntuneApps/InteractiveInstaller.schema.json",
  "title": "NSP interactive installer capture",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "Installer", "CapturedAtUtc", "ExecutionEngine", "RuntimeParameters", "Steps"],
  "properties": {
    "SchemaVersion": { "const": "2.0" },
    "Installer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["File", "Sha256", "SignatureStatus"],
      "properties": {
        "File": { "type": "string", "minLength": 1 },
        "Sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "FileVersion": { "type": ["string", "null"] },
        "ProductVersion": { "type": ["string", "null"] },
        "SignerSubject": { "type": ["string", "null"] },
        "SignatureStatus": { "type": "string", "minLength": 1 }
      }
    },
    "CapturedAtUtc": { "type": "string", "format": "date-time" },
    "CaptureProcessId": { "type": "integer", "minimum": 0 },
    "ExecutionEngine": { "enum": ["AutoIt", "AutoHotkey", "AutoItOrAutoHotkey"] },
    "RuntimeParameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Name", "Sensitive", "Description"],
        "properties": {
          "Name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
          "Sensitive": { "type": "boolean" },
          "Description": { "type": "string" }
        }
      }
    },
    "Steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Order", "Window", "Control", "Action", "Value", "TimeoutSeconds", "Optional", "Note"],
        "properties": {
          "Order": { "type": "integer", "minimum": 1 },
          "Window": {
            "type": "object",
            "additionalProperties": false,
            "required": ["Title", "Text", "MatchMode"],
            "properties": {
              "Title": { "type": "string" },
              "Text": { "type": "string" },
              "MatchMode": { "enum": ["Contains", "Exact"] }
            }
          },
          "Control": {
            "type": "object",
            "additionalProperties": false,
            "required": ["Name", "AutomationId", "ControlType", "AutoItSelector"],
            "properties": {
              "Name": { "type": "string" },
              "AutomationId": { "type": "string" },
              "ControlType": { "type": "string" },
              "AutoItSelector": { "type": "string" }
            }
          },
          "Action": { "enum": ["Click", "SetValue", "Select", "SendKeys", "WaitForWindow", "WaitForWindowClose"] },
          "Value": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["Source", "Value"],
                "properties": {
                  "Source": { "const": "Literal" },
                  "Value": { "type": "string" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["Source", "Name"],
                "properties": {
                  "Source": { "const": "RuntimeParameter" },
                  "Name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" }
                }
              }
            ]
          },
          "TimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
          "Optional": { "type": "boolean" },
          "Note": { "type": "string" }
        }
      }
    }
  }
}
