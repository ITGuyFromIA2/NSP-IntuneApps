@{
    Alias                 = 'REPLACE_WITH_CONNECTION_ALIAS'
    Server                = 'REPLACE_WITH_RAS_GATEWAY'
    Port                  = 443

    # Latest resolves the current x64 Windows MSI from the vendor's official
    # JSON download catalog each time the Intune install command runs. Use Pinned only
    # for a documented compatibility requirement.
    SourceMode            = 'Latest'
    DownloadPageUri       = 'https://www.parallels.com/products/ras/download/client/'
    PinnedMsiUri          = ''
    PinnedSha256          = ''

    # The downloaded MSI must have a valid Authenticode signature whose
    # certificate subject matches this expression.
    ExpectedSignerPattern = '(?i)Parallels|Alludo'
}
